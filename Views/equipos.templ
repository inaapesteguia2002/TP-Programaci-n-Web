package views

import (
	"DeRabona/DataBase"
	"fmt"
)

// IndexEquipos renderiza la página completa de gestión de equipos
templ IndexEquipos(equipos []DataBase.Equipo) {
	@Layout("Gestión de Equipos") {
		<section>
			<h2>Gestión de Equipos</h2>
			@EquipoForm()
			<hr/>
			<div id="contenedor-tabla-equipos">
				@EquipoList(equipos)
			</div>
		</section>
	}
}

// EquipoForm renderiza el formulario para crear un equipo (INSERT INTO equipos (nombre))
templ EquipoForm() {
	<article>
		<header><strong>Nuevo Equipo</strong></header>
		<form
			action="/equipos"
			method="POST"
			hx-post="/equipos"
			hx-target="#contenedor-tabla-equipos"
			hx-swap="innerHTML"
			hx-on:htmx:after:swap="this.reset()"
		>
			<div class="grid">
				<input type="text" name="nombre" placeholder="Nombre del Equipo (ej. Boca Juniors)" required/>
				<button type="submit">Agregar Equipo</button>
			</div>
		</form>
	</article>
}

// EquipoList renderiza la tabla de equipos
templ EquipoList(equipos []DataBase.Equipo) {
	<table class="striped">
		<thead>
			<tr>
				<th>ID</th>
				<th>Nombre</th>
				<th>Acciones</th>
			</tr>
		</thead>
		<tbody>
			for _, equipo := range equipos {
				@EquipoRow(equipo)
			}
			if len(equipos) == 0 {
				<tr>
					<td colspan="3" style="text-align: center;">No hay equipos registrados.</td>
				</tr>
			}
		</tbody>
	</table>
}

// EquipoRow maneja cada fila y el borrado individual con DELETE /equipos/{id}
templ EquipoRow(equipo DataBase.Equipo) {
	<tr>
		<td>{ fmt.Sprint(equipo.ID) }</td>
		<td>{ equipo.Nombre }</td>
		<td>
			<button
				class="secondary outline"
				hx-delete={ fmt.Sprintf("/equipos/%d", equipo.ID) }
				hx-target="closest tr"
				hx-swap="outerHTML"
				hx-confirm="¿Estás seguro de eliminar este equipo?"
			>
				Borrar
			</button>
		</td>
	</tr>
}