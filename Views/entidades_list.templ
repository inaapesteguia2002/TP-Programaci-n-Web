package Views

import (
	"fmt"
	"DeRabona/DataBase"
)

// Función auxiliar para obtener el nombre del equipo a partir de su ID
func nombreEquipo(equipos []DataBase.Equipo, id int32) string {
	for _, eq := range equipos {
		if eq.ID == id {
			return eq.Nombre
		}
	}
	return fmt.Sprintf("Equipo #%d", id)
}

// 1. LISTA DE LIGAS
templ LigaList(ligas []DataBase.Liga) {
	<div id="lista-ligas">
		<figure>
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Nombre</th>
						<th>País</th>
						<th>Acción</th>
					</tr>
				</thead>
				<tbody>
					if len(ligas) == 0 {
						<tr>
							<td colspan="4" class="empty-msg">No hay ligas registradas.</td>
						</tr>
					}
					for _, l := range ligas {
						<tr>
							<td>{ fmt.Sprintf("%d", l.ID) }</td>
							<td><strong>{ l.Nombre }</strong></td>
							<td>{ l.Pais }</td>
							<td>
								<button
									type="button"
									class="secondary outline"
									hx-delete={ fmt.Sprintf("/ligas/%d", l.ID) }
									hx-target="closest tr"
									hx-swap="outerHTML"
									hx-confirm="¿Estás seguro de que querés borrar esta liga?"
								>
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</figure>
	</div>
}

// Respuesta de creación de Liga + actualización OOB de los <select> de ligas
templ LigaListConOOB(ligas []DataBase.Liga) {
	@LigaList(ligas)
	@SelectLigaPartido(ligas, true)
	@SelectLigaTabla(ligas, true)
	@SelectLigaFiltro(ligas, 0, true)
}

// 2. LISTA DE EQUIPOS
templ EquipoList(equipos []DataBase.Equipo) {
	<div id="lista-equipos">
		<figure>
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Nombre del Club</th>
						<th>Acción</th>
					</tr>
				</thead>
				<tbody>
					if len(equipos) == 0 {
						<tr>
							<td colspan="3" class="empty-msg">No hay equipos registrados.</td>
						</tr>
					}
					for _, eq := range equipos {
						<tr>
							<td>{ fmt.Sprintf("%d", eq.ID) }</td>
							<td><strong>{ eq.Nombre }</strong></td>
							<td>
								<button
									type="button"
									class="secondary outline"
									hx-delete={ fmt.Sprintf("/equipos/%d", eq.ID) }
									hx-target="closest tr"
									hx-swap="outerHTML"
									hx-confirm="¿Estás seguro de que querés borrar este equipo?"
								>
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</figure>
	</div>
}

// Respuesta de creación de Equipo + actualización OOB de los <select> de equipos
templ EquipoListConOOB(equipos []DataBase.Equipo) {
	@EquipoList(equipos)
	@SelectEquipoLocal(equipos, true)
	@SelectEquipoVisitante(equipos, true)
	@SelectEquipoTabla(equipos, true)
}

// 3. LISTA DE PARTIDOS
templ PartidoList(partidos []DataBase.Partido, equipos []DataBase.Equipo) {
	<div id="lista-partidos">
		<figure>
			<table>
				<thead>
					<tr>
						<th>Partido y Resultado</th>
						<th>Estado</th>
						<th>Acción</th>
					</tr>
				</thead>
				<tbody>
					if len(partidos) == 0 {
						<tr>
							<td colspan="3" class="empty-msg">No hay partidos registrados.</td>
						</tr>
					}
					for _, p := range partidos {
						<tr>
							<td>
								<strong>{ nombreEquipo(equipos, p.EquipoLocalID) }</strong>
								{ fmt.Sprintf(" %d - %d ", p.GolesLocal.Int32, p.GolesVisitante.Int32) }
								<strong>{ nombreEquipo(equipos, p.EquipoVisitanteID) }</strong>
							</td>
							<td><mark>{ p.Estado.String }</mark></td>
							<td>
								<button
									type="button"
									class="secondary outline"
									hx-delete={ fmt.Sprintf("/partidos/%d", p.ID) }
									hx-target="closest tr"
									hx-swap="outerHTML"
									hx-confirm="¿Estás seguro de que querés borrar este partido?"
								>
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</figure>
	</div>
}

// Respuesta de PartidoList + mensaje de error OOB (limpia o muestra alerta sin recargar)
templ PartidoListConEstado(partidos []DataBase.Partido, equipos []DataBase.Equipo, errorMsg string) {
	@PartidoList(partidos, equipos)
	@AlertaErrorPartidos(errorMsg, true)
}

// Respuesta de creación de Partido + actualización OOB de la alerta y de la Tabla de Posiciones
templ PartidoListConTabla(partidos []DataBase.Partido, equipos []DataBase.Equipo, ligas []DataBase.Liga, tabla []DataBase.GetTablaPorLigaRow, ligaSeleccionada int32) {
	@PartidoList(partidos, equipos)
	@AlertaErrorPartidos("", true)
	@TablaListOOB(ligas, tabla, ligaSeleccionada)
}

// 4. TABLA DE POSICIONES
templ TablaList(ligas []DataBase.Liga, tabla []DataBase.GetTablaPorLigaRow, ligaSeleccionada int32) {
	@tablaListRender(ligas, tabla, ligaSeleccionada, false)
}

// Versión Out-of-Band para actualizar la tabla de rebote desde otra acción (ej. crear partido)
templ TablaListOOB(ligas []DataBase.Liga, tabla []DataBase.GetTablaPorLigaRow, ligaSeleccionada int32) {
	@tablaListRender(ligas, tabla, ligaSeleccionada, true)
}

templ tablaListRender(ligas []DataBase.Liga, tabla []DataBase.GetTablaPorLigaRow, ligaSeleccionada int32, oob bool) {
	<div
		id="lista-tabla"
		if oob {
			hx-swap-oob="true"
		}
	>
		<form
			action="/#seccion-tabla"
			method="GET"
			hx-get="/"
			hx-target="#lista-tabla"
			hx-swap="outerHTML"
			class="selector-liga-form"
		>
			@SelectLigaFiltro(ligas, ligaSeleccionada, false)
			<button type="submit" class="contrast">Ver Tabla</button>
		</form>

		<figure>
			<table class="tabla-posiciones">
				<thead>
					<tr>
						<th class="col-pos">#</th>
						<th class="col-equipo">Equipo</th>
						<th class="col-pts" title="Puntos">Pts</th>
						<th class="col-stat" title="Partidos Jugados">PJ</th>
						<th class="col-stat" title="Partidos Ganados">G</th>
						<th class="col-stat" title="Partidos Empatados">E</th>
						<th class="col-stat" title="Partidos Perdidos">P</th>
						<th class="col-accion">Acción</th>
					</tr>
				</thead>
				<tbody>
					if ligaSeleccionada == 0 {
						<tr>
							<td colspan="8" class="empty-msg">Seleccioná una liga arriba para visualizar la tabla de posiciones.</td>
						</tr>
					} else if len(tabla) == 0 {
						<tr>
							<td colspan="8" class="empty-msg">Todavía no hay equipos inscriptos en esta competición.</td>
						</tr>
					} else {
						for i, pos := range tabla {
							<tr class={ templ.KV("fila-lider", i == 0) }>
								<td class="col-pos">
									<span class={ "badge-pos", templ.KV("pos-1", i == 0) }>
										{ fmt.Sprintf("%d", i+1) }
									</span>
								</td>
								<td class="col-equipo">
									<strong>{ pos.Equipo }</strong>
								</td>
								<td class="col-pts">
									<span class="pts-pill">{ fmt.Sprintf("%d", pos.Puntos.Int32) }</span>
								</td>
								<td class="col-stat">{ fmt.Sprintf("%d", pos.PartidosJugados.Int32) }</td>
								<td class="col-stat stat-g">{ fmt.Sprintf("%d", pos.PartidosGanados.Int32) }</td>
								<td class="col-stat">{ fmt.Sprintf("%d", pos.PartidosEmpatados.Int32) }</td>
								<td class="col-stat stat-p">{ fmt.Sprintf("%d", pos.PartidosPerdidos.Int32) }</td>
								<td class="col-accion">
									<button
										type="button"
										class="secondary outline"
										title="Quitar de la liga"
										hx-delete={ fmt.Sprintf("/tabla/%d/%d", pos.LigaID, pos.EquipoID) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm="¿Estás seguro de que querés sacar a este equipo de la liga?"
									>
										Sacar
									</button>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</figure>
	</div>
}
