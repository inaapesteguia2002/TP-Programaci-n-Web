package views

import "DeRabona/DataBase"

// Estructura base de la página (HTML, HEAD, BODY)
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Pico.css para el estilo minimalista -->
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
		</head>
		<body>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}

// Componente de página principal que une el Layout, los formularios y las listas
templ IndexPage( ligas []DataBase.Liga, equipos []DataBase.Equipo, partidos []DataBase.Partido, tabla []DataBase.GetTablaPorLigaRow, ligaSeleccionada int32,) {
	@Layout("De Rabona - Administración") {
		<h1>Panel de Administración "De Rabona"</h1>

		<hr/>
		<section id="seccion-ligas">
			<h2>1. Ligas</h2>
			@LigaForm()
			@LigaList(ligas)
		</section>

		<hr/>
		<section id="seccion-equipos">
			<h2>2. Equipos</h2>
			@EquipoForm()
			@EquipoList(equipos)
		</section>

		<hr/>
		<section id="seccion-partidos">
			<h2>3. Partidos</h2>
			@PartidoForm(ligas, equipos)
			@PartidoList(partidos)
		</section>

		<hr/>
		<section id="seccion-tabla">
			<h2>4. Tabla de Posiciones</h2>
			@TablaForm(ligas, equipos)
			@TablaList(ligas, tabla, ligaSeleccionada)
		</section>
	}
}