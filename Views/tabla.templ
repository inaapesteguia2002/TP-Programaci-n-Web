tabla.templ: package views

import (
	"DeRabona/DataBase"
	"fmt"
)

// IndexTabla muestra el filtro por liga, el formulario para inscribir equipos en una liga y la tabla de posiciones
templ IndexTabla(ligaActualID int32, filas []DataBase.GetTablaPorLigaRow, ligas []DataBase.Liga, equipos []DataBase.Equipo) {
	@Layout("Tabla de Posiciones") {
		<section>
			<h2>Tabla de Posiciones</h2>

			<!-- Filtro para cambiar la liga visualizada (GET /tabla?liga_id=X) -->
			<article>
				<header><strong>Seleccionar Liga a Consultar</strong></header>
				<form action="/tabla" method="GET">
					<div class="grid">
						<select name="liga_id" required>
							for _, l := range ligas {
								<option value={ fmt.Sprint(l.ID) } selected?={ l.ID == ligaActualID }>
									{ l.Nombre } ({ l.Pais })
								</option>
							}
						</select>
						<button type="submit">Ver Tabla</button>
					</div>
				</form>
			</article>

			@TablaForm(ligas, equipos)
			<hr/>
			<div id="contenedor-tabla-posiciones">
				@TablaList(filas)
			</div>
		</section>
	}
}

// TablaForm inscribe un equipo en la tabla de posiciones de una liga (CreateTabla)
templ TablaForm(ligas []DataBase.Liga, equipos []DataBase.Equipo) {
	<article>
		<header><strong>Inscribir Equipo en Liga</strong></header>
		<form
			action="/tabla"
			method="POST"
			hx-post="/tabla"
			hx-target="#contenedor-tabla-posiciones"
			hx-swap="innerHTML"
			hx-on:htmx:after:swap="this.reset()"
		>
			<div class="grid">
				<select name="liga_id" required>
					<option value="" disabled selected>Seleccione una Liga...</option>
					for _, l := range ligas {
						<option value={ fmt.Sprint(l.ID) }>{ l.Nombre }</option>
					}
				</select>

				<select name="equipo_id" required>
					<option value="" disabled selected>Seleccione un Equipo...</option>
					for _, eq := range equipos {
						<option value={ fmt.Sprint(eq.ID) }>{ eq.Nombre }</option>
					}
				</select>

				<button type="submit">Inscribir Equipo</button>
			</div>
		</form>
	</article>
}

// TablaList renderiza las posiciones usando GetTablaPorLigaRow generado por sqlc
templ TablaList(filas []DataBase.GetTablaPorLigaRow) {
	<table class="striped">
		<thead>
			<tr>
				<th>Pos</th>
				<th>Equipo</th>
				<th>PTS</th>
				<th>PJ</th>
				<th>PG</th>
				<th>PE</th>
				<th>PP</th>
			</tr>
		</thead>
		<tbody>
			for i, fila := range filas {
				@TablaRow(i+1, fila)
			}
			if len(filas) == 0 {
				<tr>
					<td colspan="7" style="text-align: center;">No hay equipos inscriptos en esta liga.</td>
				</tr>
			}
		</tbody>
	</table>
}

// TablaRow renderiza una fila de la tabla de posiciones
templ TablaRow(posicion int, fila DataBase.GetTablaPorLigaRow) {
	<tr>
		<td>{ fmt.Sprint(posicion) }</td>
		<td><strong>{ fila.Equipo }</strong></td>
		<td><strong>{ fmt.Sprint(fila.Puntos.Int32) }</strong></td>
		<td>{ fmt.Sprint(fila.PartidosJugados.Int32) }</td>
		<td>{ fmt.Sprint(fila.PartidosGanados.Int32) }</td>
		<td>{ fmt.Sprint(fila.PartidosEmpatados.Int32) }</td>
		<td>{ fmt.Sprint(fila.PartidosPerdidos.Int32) }</td>
	</tr>
}